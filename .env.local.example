# OpenRouter — AI scoring and summaries (OpenAI-compatible API).
# Get a key at https://openrouter.ai — never commit real keys.
OPENROUTER_API_KEY=sk-or-v1-placeholder-replace-me

# Mailgun — transactional email for digests.
MAILGUN_API_KEY=key-placeholder-replace-me
MAILGUN_DOMAIN=mg.example.co.nz
MAILGUN_FROM=Media Monitor <digest@mg.example.co.nz>

# Shared secret for Vercel Cron / manual triggers (`/api/ingest`, `/api/digest`).
# Use a long random string; validate on each request.
CRON_SECRET=replace-with-random-secret
